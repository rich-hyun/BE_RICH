rules_version = '2';

// ─────────────────────────────────────────────────────────────
// BE RICH Firestore 보안 규칙 (템플릿)
//
// "ADMIN_UID" 는 실제 관리자 계정의 UID로 교체해야 합니다.
//  - 방법 1: `npm run rules:build` → firestore.rules.generated 생성 후 `firebase deploy --only firestore:rules`
//  - 방법 2: Firebase 콘솔 > Firestore > 규칙 탭에 이 내용을 붙여넣고 ADMIN_UID를 직접 교체 후 게시
//
// 원칙
//  1) 로그인하지 않은 사용자: 읽기/쓰기 모두 거부
//  2) 자산 데이터는 관리자 UID 경로(users/ADMIN_UID/...) 하나만 사용
//  3) 관리자: 모든 데이터 읽기/쓰기 + 계정(members) 관리
//  3-1) 백업·복원 관련 데이터(변경 이력, 마지막 백업 시각, 계정 목록)는 관리자만 조회 가능
//  4) 관리자가 등록한 계정(members/{uid} 문서가 있는 계정): 읽기 가능,
//     canEdit == true 일 때만 쓰기 가능. 그 외 Firebase 계정은 모두 거부
//  5) 아래에 명시하지 않은 모든 경로는 기본 거부
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null && request.auth.uid == "ADMIN_UID";
    }

    function memberPath() {
      return /databases/$(database)/documents/members/$(request.auth.uid);
    }

    function isMember() {
      return request.auth != null && exists(memberPath());
    }

    function canRead(userId) {
      return userId == "ADMIN_UID" && (isOwner() || isMember());
    }

    function canWrite(userId) {
      return userId == "ADMIN_UID"
        && (isOwner() || (isMember() && get(memberPath()).data.canEdit == true));
    }

    // 등록 계정: 아이디(영문 소문자 시작, 3~20자)와 수정 권한 여부
    function validMember() {
      return data().keys().hasOnly(['username', 'canEdit', 'createdAt', 'updatedAt'])
        && data().username is string && data().username.matches('^[a-z][a-z0-9_]{2,19}$')
        && data().canEdit is bool;
    }

    function data() {
      return request.resource.data;
    }

    function isIsoDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function optString(field, max) {
      return !(field in data()) || (data()[field] is string && data()[field].size() <= max);
    }

    // 월별 자산 기록: 문서 ID = 날짜(YYYY-MM-DD), 금액은 정수(원)
    function validAssetRecord(recordId) {
      return isIsoDate(data().date)
        && data().date == recordId
        && data().isa is int
        && data().brokerage is int
        && data().crypto is int
        && data().gold is int
        && data().cash is int
        && optString('memo', 1000);
    }

    function validHolding() {
      return isIsoDate(data().snapshotDate)
        && data().name is string && data().name.size() > 0 && data().name.size() <= 200
        && data().marketValue is int && data().marketValue >= 0
        && data().accountType in ['brokerage', 'isa']
        && optString('symbol', 40)
        && optString('memo', 1000);
    }

    function validComposition() {
      return data().symbol is string && data().symbol.size() > 0 && data().symbol.size() <= 40
        && isIsoDate(data().asOfDate)
        && data().source is string && data().source.size() <= 500
        && data().industries is map
        && data().holdings is list && data().holdings.size() <= 500;
    }

    // 변경 이력(수정·삭제 직전 문서 보존): 추가 전용, 내용 변경 불가
    function validHistory() {
      return data().keys().hasOnly(['collection', 'docId', 'action', 'label', 'data', 'savedAt'])
        && data().collection in ['assetRecords', 'holdings', 'etfCompositions', 'goals', 'settings']
        && data().docId is string && data().docId.size() > 0 && data().docId.size() <= 200
        && data().action in ['update', 'delete']
        && data().label is string && data().label.size() <= 200
        && data().data is map
        && data().savedAt is int;
    }

    function validGoal() {
      return data().targetYear is int
        && data().targetYear >= 1900 && data().targetYear <= 2200
        && data().targetAmount is int && data().targetAmount > 0;
    }

    match /users/{userId} {
      // 상위 사용자 문서 자체는 사용하지 않음
      allow read, write: if false;

      match /assetRecords/{recordId} {
        allow read: if canRead(userId);
        allow delete: if canWrite(userId);
        allow create, update: if canWrite(userId) && validAssetRecord(recordId);
      }

      match /holdings/{holdingId} {
        allow read: if canRead(userId);
        allow delete: if canWrite(userId);
        allow create, update: if canWrite(userId) && validHolding();
      }

      match /etfCompositions/{compositionId} {
        allow read: if canRead(userId);
        allow delete: if canWrite(userId);
        allow create, update: if canWrite(userId) && validComposition();
      }

      match /goals/{goalId} {
        allow read: if canRead(userId);
        allow delete: if canWrite(userId);
        allow create, update: if canWrite(userId) && validGoal();
      }

      // 변경 이력: 기록(추가)은 쓰기 권한이 있는 계정의 수정·삭제와 함께 이뤄지지만,
      // 조회·삭제는 관리자만 가능하고 한번 기록된 이력은 수정할 수 없음
      match /history/{historyId} {
        allow read, delete: if isOwner() && userId == "ADMIN_UID";
        allow create: if canWrite(userId) && validHistory();
        allow update: if false;
      }

      // 백업 메타(마지막 백업 시각): 관리자 전용
      match /meta/{metaId} {
        allow read: if isOwner() && userId == "ADMIN_UID" && metaId == 'backup';
        allow write: if isOwner() && userId == "ADMIN_UID" && metaId == 'backup'
          && request.resource.data.keys().hasOnly(['lastBackupAt'])
          && request.resource.data.lastBackupAt is int;
      }

      match /settings/{settingId} {
        allow read: if canRead(userId) && settingId == 'general';
        allow write: if canWrite(userId) && settingId == 'general';
      }
    }

    match /members/{memberId} {
      // 관리자는 전체 조회, 등록 계정은 자기 문서(권한)만 조회
      allow read: if isOwner() || (request.auth != null && request.auth.uid == memberId);
      // 계정 추가·권한 변경·삭제는 관리자만. 관리자 자신은 등록 대상이 아님
      allow create, update: if isOwner() && memberId != "ADMIN_UID" && validMember();
      allow delete: if isOwner();
    }

    // 그 외 모든 경로는 규칙이 없으므로 자동으로 거부됩니다.
  }
}

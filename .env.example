# ─────────────────────────────────────────────────────────────
# 이 파일을 복사해 `.env.local` 을 만들고 값을 채우세요. (.env.local 은 git에 올라가지 않습니다)
#
# ⚠️ 아래 값은 모두 "공개되어도 되는" 브라우저용 값입니다.
#    VITE_ 로 시작하는 값은 빌드 결과(JavaScript)에 그대로 포함되어 누구나 볼 수 있습니다.
#    비밀번호, 서비스 계정 키(JSON), 관리자 토큰 등 비밀값은 절대 여기에 넣지 마세요.
# ─────────────────────────────────────────────────────────────

# Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱(웹) > SDK 설정 및 구성(firebaseConfig)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Authentication에서 만든 관리자 계정 이메일 (비밀번호는 넣지 않음!). 비워 두면 로그인 화면에 이메일 칸이 표시됩니다.
VITE_ADMIN_EMAIL=
# 같은 화면의 "사용자 UID" 값. 화면에서 다른 계정을 즉시 차단하는 용도이며,
# 실제 데이터 보호는 Firestore 보안 규칙의 UID 검사가 담당합니다.
VITE_ADMIN_UID=

# 로그인 화면에서 관리자 이메일 대신 입력할 아이디 (기본값: jaehyun)
# VITE_ADMIN_USERNAME=jaehyun
